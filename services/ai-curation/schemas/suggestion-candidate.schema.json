{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmaops.example/schemas/ai-curation/suggestion-candidate.schema.json",
  "title": "PharmaOps AI Suggestion Candidate",
  "description": "Release-ineligible AI curation candidate. Candidates are proposals only and must pass governed human review before any downstream publication path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "suggestion_id",
    "tenant_id",
    "environment",
    "release_id",
    "suggestion_type",
    "proposal_type",
    "assertion_type",
    "lifecycle_status",
    "review_status",
    "candidate_payload",
    "payload",
    "score",
    "confidence_score",
    "confidence_band",
    "confidence_source",
    "confidence",
    "model",
    "model_name",
    "model_version",
    "prompt_version",
    "evidence_refs",
    "source_spans",
    "provenance_id",
    "provenance",
    "governance",
    "safety",
    "duplicate_status",
    "rationale",
    "created_at",
    "created_by"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-suggestion-candidate.v1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "suggestion_id": {
      "type": "string",
      "minLength": 1,
      "description": "Workflow/API compatibility alias. Must equal candidate_id."
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "release_id": {
      "type": "null",
      "description": "AI suggestions are never members of a released graph."
    },
    "suggestion_type": {
      "enum": [
        "document_entity_extraction",
        "entity_linking",
        "synonym",
        "relationship",
        "duplicate"
      ]
    },
    "proposal_type": {
      "enum": [
        "synonym",
        "mapping",
        "relationship",
        "evidence-link"
      ],
      "description": "Proposal workflow compatibility type. entity_linking and duplicate candidates map to mapping; document_entity_extraction maps to evidence-link."
    },
    "assertion_type": {
      "const": "model_suggested"
    },
    "lifecycle_status": {
      "const": "proposed"
    },
    "review_status": {
      "const": "proposed"
    },
    "candidate_payload": {
      "type": "object",
      "minProperties": 1
    },
    "payload": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "assertion_type",
        "evidence_refs",
        "source_spans"
      ],
      "properties": {
        "assertion_type": {
          "const": "model_suggested"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1
        },
        "source_spans": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Workflow compatibility alias for score."
    },
    "confidence_band": {
      "enum": [
        "high",
        "medium",
        "low",
        "blocked"
      ]
    },
    "confidence_source": {
      "const": "model_calibrated_score"
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "band",
        "source",
        "fabricated",
        "calibration"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "band": {
          "enum": [
            "high",
            "medium",
            "low",
            "blocked"
          ]
        },
        "source": {
          "const": "calibrated_model_score"
        },
        "fabricated": {
          "const": false
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calibration_id",
            "calibration_version",
            "calibration_method",
            "calibrated_score",
            "sample_size",
            "metrics_source"
          ],
          "properties": {
            "calibration_id": {
              "type": "string",
              "minLength": 1
            },
            "calibration_version": {
              "type": "string",
              "minLength": 1
            },
            "calibration_method": {
              "type": "string",
              "minLength": 1
            },
            "calibrated_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sample_size": {
              "type": "integer",
              "minimum": 1
            },
            "expected_accuracy": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "observed_accuracy": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "confidence_interval": {
              "type": [
                "array",
                "null"
              ],
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "metrics_source": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_version",
        "prompt_version"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "description": "Workflow compatibility alias for model.model_id."
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "description": "Workflow compatibility alias for model.model_version."
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Top-level prompt version for API/workflow consumers."
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_role",
          "source_name",
          "source_version",
          "source_span_ids"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_role": {
            "type": "string",
            "minLength": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_record_uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_span_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disclaimer_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "span_id",
          "source_record_id",
          "field_path",
          "start_offset",
          "end_offset",
          "text",
          "evidence_id",
          "source_id",
          "document_id"
        ],
        "properties": {
          "span_id": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1
          },
          "field_path": {
            "type": "string",
            "minLength": 1
          },
          "start_offset": {
            "type": "integer",
            "minimum": 0
          },
          "end_offset": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "quote_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "provenance_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_id",
        "model_name",
        "model_version",
        "evidence_refs",
        "source_spans",
        "actor",
        "activity",
        "method",
        "source",
        "time",
        "audit_event_id"
      ],
      "properties": {
        "provenance_id": {
          "type": "string",
          "minLength": 1
        },
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1
        },
        "source_spans": {
          "type": "array",
          "minItems": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "activity": {
          "const": "ai_suggestion_generation"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_name",
            "source_version"
          ],
          "properties": {
            "source_name": {
              "type": "string",
              "minLength": 1
            },
            "source_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "time": {
          "type": "string",
          "minLength": 1
        },
        "audit_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_publish",
        "requires_human_review",
        "release_eligible",
        "released_graph_target",
        "visual_state",
        "approval_state",
        "duplicate_policy"
      ],
      "properties": {
        "auto_publish": {
          "const": false
        },
        "requires_human_review": {
          "const": true
        },
        "release_eligible": {
          "const": false
        },
        "released_graph_target": {
          "type": "null"
        },
        "visual_state": {
          "const": "ai_suggestion_distinct"
        },
        "approval_state": {
          "const": "unapproved"
        },
        "duplicate_policy": {
          "enum": [
            "not_applicable",
            "flag_only_never_merge"
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faers_context",
        "causality_allowed",
        "faers_causal_blocked"
      ],
      "properties": {
        "faers_context": {
          "type": "boolean"
        },
        "causality_allowed": {
          "type": "boolean"
        },
        "faers_causal_blocked": {
          "type": "boolean"
        }
      }
    },
    "duplicate_status": {
      "enum": [
        "not_duplicate",
        "possible_duplicate",
        "duplicate",
        "not_evaluated"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "const": "service:ai-curation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "suggestion_type": {
            "const": "duplicate"
          }
        }
      },
      "then": {
        "properties": {
          "governance": {
            "properties": {
              "duplicate_policy": {
                "const": "flag_only_never_merge"
              }
            }
          }
        }
      }
    }
  ]
}

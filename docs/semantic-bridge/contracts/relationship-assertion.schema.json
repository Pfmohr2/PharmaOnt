{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmaops.example/schemas/semantic-bridge/relationship-assertion.schema.json",
  "title": "PharmaOps Semantic Bridge RelationshipAssertion",
  "description": "First-class governed cross-domain relationship assertion. A relationship assertion is not an opaque graph edge; it carries class, evidence, provenance, confidence, review, license, and release-context metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relationship_assertion_id",
    "tenant_id",
    "environment",
    "source_entity_id",
    "target_entity_id",
    "predicate",
    "relationship_class",
    "assertion_type",
    "directionality",
    "polarity",
    "evidence_refs",
    "source_record_ids",
    "source_names",
    "source_versions",
    "confidence",
    "review_status",
    "release_context",
    "data_license",
    "known_limitations",
    "warnings",
    "created_by",
    "created_at",
    "updated_at",
    "provenance_id",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "semantic-bridge.relationship-assertion.v1" },
    "relationship_assertion_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "source_entity_id": { "type": "string", "minLength": 1 },
    "target_entity_id": { "type": "string", "minLength": 1 },
    "predicate": { "$ref": "#/$defs/relationshipPredicate" },
    "relationship_class": { "$ref": "#/$defs/relationshipClass" },
    "secondary_relationship_tags": {
      "type": "array",
      "items": { "$ref": "#/$defs/secondaryRelationshipTag" },
      "uniqueItems": true
    },
    "assertion_type": { "$ref": "#/$defs/assertionType" },
    "directionality": {
      "type": "string",
      "enum": ["directed", "undirected", "bidirectional"]
    },
    "polarity": {
      "type": "string",
      "enum": ["positive", "negative", "conflicting", "unknown"]
    },
    "causal_claim_status": {
      "type": "string",
      "enum": ["not_causal", "causal_prohibited", "causal_review_required", "causal_review_approved", "blocked_overclaim"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "source_record_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1
    },
    "source_versions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1
    },
    "confidence": { "$ref": "#/$defs/confidence" },
    "review_status": { "$ref": "#/$defs/reviewStatus" },
    "reviewed_by": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "release_context": { "$ref": "#/$defs/releaseContext" },
    "data_license": { "$ref": "#/$defs/dataLicense" },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationshipWarning" },
      "uniqueItems": true
    },
    "blocked_rationale": { "type": ["string", "null"] },
    "validation_report_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "provenance_id": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": { "properties": { "assertion_type": { "const": "model_suggested" } }, "required": ["assertion_type"] },
      "then": {
        "properties": {
          "review_status": { "enum": ["draft", "proposed", "in_review", "rejected", "deprecated", "superseded"] },
          "release_context": {
            "type": "object",
            "required": ["release_id", "scope"],
            "properties": {
              "release_id": { "type": "null" },
              "scope": { "enum": ["working"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          { "properties": { "relationship_class": { "const": "safety" } }, "required": ["relationship_class"] },
          {
            "properties": {
              "secondary_relationship_tags": {
                "contains": { "const": "causal_sensitive" }
              }
            },
            "required": ["secondary_relationship_tags"]
          }
        ]
      },
      "then": { "required": ["causal_claim_status"] }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "identity" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/identityPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "vocabulary_crosswalk" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/vocabularyCrosswalkPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "hierarchical" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/hierarchicalPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "mechanistic" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/mechanisticPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "clinical" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/clinicalPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "safety" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/safetyPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "regulatory" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/regulatoryPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "commercial" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/commercialPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "operational" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/operationalPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "evidence_support" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/evidenceSupportPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "inferred" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/inferredPredicate" } } }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "hypothesis" } }, "required": ["relationship_class"] },
      "then": { "properties": { "predicate": { "$ref": "#/$defs/hypothesisPredicate" } } }
    },
    {
      "if": { "properties": { "review_status": { "const": "released" } }, "required": ["review_status"] },
      "then": {
        "properties": {
          "assertion_type": { "not": { "const": "model_suggested" } },
          "reviewed_by": { "type": "string", "minLength": 1 },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "release_context": {
            "type": "object",
            "required": ["release_id", "scope"],
            "properties": {
              "release_id": { "type": "string", "minLength": 1 },
              "scope": { "const": "release" },
              "included_in_release": { "const": true }
            }
          },
          "data_license": {
            "type": "object",
            "required": ["license_status", "license_classification", "permitted_uses"],
            "properties": {
              "license_status": { "not": { "enum": ["blocked", "pending_review"] } },
              "license_classification": { "not": { "const": "blocked_pending_legal_review" } },
              "permitted_uses": { "contains": { "const": "release" } }
            }
          }
        },
        "required": ["reviewed_by", "reviewed_at", "validation_report_ids"]
      }
    },
    {
      "if": { "properties": { "relationship_class": { "const": "blocked" } }, "required": ["relationship_class"] },
      "then": {
        "properties": { "predicate": { "$ref": "#/$defs/blockedPredicate" } },
        "required": ["blocked_rationale"]
      }
    }
  ],
  "$defs": {
    "relationshipClass": {
      "type": "string",
      "enum": [
        "identity",
        "vocabulary_crosswalk",
        "hierarchical",
        "mechanistic",
        "clinical",
        "safety",
        "regulatory",
        "commercial",
        "operational",
        "evidence_support",
        "inferred",
        "hypothesis",
        "blocked"
      ]
    },
    "relationshipPredicate": {
      "type": "string",
      "enum": [
        "same_as", "pharmrel:same_as",
        "has_synonym", "pharmrel:has_synonym",
        "has_external_identifier", "pharmrel:has_external_identifier",
        "identity_replaced_by", "pharmrel:identity_replaced_by",
        "exactMatch", "pharmrel:exactMatch",
        "closeMatch", "pharmrel:closeMatch",
        "broadMatch", "pharmrel:broadMatch",
        "narrowMatch", "pharmrel:narrowMatch",
        "relatedMatch", "pharmrel:relatedMatch",
        "replacedBy", "pharmrel:replacedBy",
        "hasDbXref", "pharmrel:hasDbXref",
        "notMatch", "pharmrel:notMatch",
        "uncertainMatch", "pharmrel:uncertainMatch",
        "requiresReview", "pharmrel:requiresReview",
        "term_maps_to_standard", "pharmrel:term_maps_to_standard",
        "regulatory_crosswalk_to", "pharmrel:regulatory_crosswalk_to",
        "broader_than", "pharmrel:broader_than",
        "narrower_than", "pharmrel:narrower_than",
        "parent_of", "pharmrel:parent_of",
        "child_of", "pharmrel:child_of",
        "part_of", "pharmrel:part_of",
        "has_part", "pharmrel:has_part",
        "subclass_of", "pharmrel:subclass_of",
        "compound_has_target", "pharmrel:compound_has_target",
        "target_associated_with_disease", "pharmrel:target_associated_with_disease",
        "mechanistically_related_to", "pharmrel:mechanistically_related_to",
        "inhibits", "pharmrel:inhibits",
        "activates", "pharmrel:activates",
        "binds_target", "pharmrel:binds_target",
        "modulates_pathway", "pharmrel:modulates_pathway",
        "trial_studies_condition", "pharmrel:trial_studies_condition",
        "trial_uses_intervention", "pharmrel:trial_uses_intervention",
        "trial_has_endpoint", "pharmrel:trial_has_endpoint",
        "clinically_related_to", "pharmrel:clinically_related_to",
        "associated_with_outcome", "pharmrel:associated_with_outcome",
        "biomarker_stratifies_response", "pharmrel:biomarker_stratifies_response",
        "product_has_adverse_event", "pharmrel:product_has_adverse_event",
        "safety_context_related_to", "pharmrel:safety_context_related_to",
        "has_reported_event_context", "pharmrel:has_reported_event_context",
        "label_mentions_safety_event", "pharmrel:label_mentions_safety_event",
        "safety_signal_for_investigation", "pharmrel:safety_signal_for_investigation",
        "uses_submission_term", "pharmrel:uses_submission_term",
        "label_contains_concept", "pharmrel:label_contains_concept",
        "submission_codelist_maps_to", "pharmrel:submission_codelist_maps_to",
        "controlled_term_for_context", "pharmrel:controlled_term_for_context",
        "commercially_related_to", "pharmrel:commercially_related_to",
        "product_aligned_to_indication", "pharmrel:product_aligned_to_indication",
        "market_segment_for_population", "pharmrel:market_segment_for_population",
        "payer_concept_related_to", "pharmrel:payer_concept_related_to",
        "operational_dependency_of", "pharmrel:operational_dependency_of",
        "dataset_feeds_dashboard", "pharmrel:dataset_feeds_dashboard",
        "api_consumer_uses_term", "pharmrel:api_consumer_uses_term",
        "workflow_depends_on_source", "pharmrel:workflow_depends_on_source",
        "downstream_uses_mapping", "pharmrel:downstream_uses_mapping",
        "entity_supported_by_evidence", "pharmrel:entity_supported_by_evidence",
        "assertion_supported_by_evidence", "pharmrel:assertion_supported_by_evidence",
        "evidence_supports_relationship", "pharmrel:evidence_supports_relationship",
        "evidence_contradicts_relationship", "pharmrel:evidence_contradicts_relationship",
        "evidence_context_for_relationship", "pharmrel:evidence_context_for_relationship",
        "inferred_from_path", "pharmrel:inferred_from_path",
        "inferred_mechanistic_bridge", "pharmrel:inferred_mechanistic_bridge",
        "inferred_clinical_bridge", "pharmrel:inferred_clinical_bridge",
        "inferred_safety_context", "pharmrel:inferred_safety_context",
        "hypothesis_bridge", "pharmrel:hypothesis_bridge",
        "is_hypothesis_about", "pharmrel:is_hypothesis_about",
        "may_relate_to_investigation", "pharmrel:may_relate_to_investigation",
        "accepted_for_investigation", "pharmrel:accepted_for_investigation",
        "convertedToRelationshipAssertion", "pharmrel:convertedToRelationshipAssertion",
        "unsupported", "pharmrel:unsupported",
        "blocked", "pharmrel:blocked",
        "contradicted_by_evidence", "pharmrel:contradicted_by_evidence",
        "license_blocked", "pharmrel:license_blocked",
        "causal_claim_blocked", "pharmrel:causal_claim_blocked",
        "access_blocked", "pharmrel:access_blocked"
      ]
    },
    "identityPredicate": {
      "enum": ["same_as", "pharmrel:same_as", "has_synonym", "pharmrel:has_synonym", "has_external_identifier", "pharmrel:has_external_identifier", "identity_replaced_by", "pharmrel:identity_replaced_by", "exactMatch", "pharmrel:exactMatch"]
    },
    "vocabularyCrosswalkPredicate": {
      "enum": ["exactMatch", "pharmrel:exactMatch", "closeMatch", "pharmrel:closeMatch", "broadMatch", "pharmrel:broadMatch", "narrowMatch", "pharmrel:narrowMatch", "relatedMatch", "pharmrel:relatedMatch", "replacedBy", "pharmrel:replacedBy", "hasDbXref", "pharmrel:hasDbXref", "notMatch", "pharmrel:notMatch", "uncertainMatch", "pharmrel:uncertainMatch", "requiresReview", "pharmrel:requiresReview", "term_maps_to_standard", "pharmrel:term_maps_to_standard", "regulatory_crosswalk_to", "pharmrel:regulatory_crosswalk_to"]
    },
    "hierarchicalPredicate": {
      "enum": ["broader_than", "pharmrel:broader_than", "narrower_than", "pharmrel:narrower_than", "parent_of", "pharmrel:parent_of", "child_of", "pharmrel:child_of", "part_of", "pharmrel:part_of", "has_part", "pharmrel:has_part", "subclass_of", "pharmrel:subclass_of"]
    },
    "mechanisticPredicate": {
      "enum": ["compound_has_target", "pharmrel:compound_has_target", "target_associated_with_disease", "pharmrel:target_associated_with_disease", "mechanistically_related_to", "pharmrel:mechanistically_related_to", "inhibits", "pharmrel:inhibits", "activates", "pharmrel:activates", "binds_target", "pharmrel:binds_target", "modulates_pathway", "pharmrel:modulates_pathway"]
    },
    "clinicalPredicate": {
      "enum": ["trial_studies_condition", "pharmrel:trial_studies_condition", "trial_uses_intervention", "pharmrel:trial_uses_intervention", "trial_has_endpoint", "pharmrel:trial_has_endpoint", "clinically_related_to", "pharmrel:clinically_related_to", "associated_with_outcome", "pharmrel:associated_with_outcome", "biomarker_stratifies_response", "pharmrel:biomarker_stratifies_response"]
    },
    "safetyPredicate": {
      "enum": ["product_has_adverse_event", "pharmrel:product_has_adverse_event", "safety_context_related_to", "pharmrel:safety_context_related_to", "has_reported_event_context", "pharmrel:has_reported_event_context", "label_mentions_safety_event", "pharmrel:label_mentions_safety_event", "safety_signal_for_investigation", "pharmrel:safety_signal_for_investigation"]
    },
    "regulatoryPredicate": {
      "enum": ["regulatory_crosswalk_to", "pharmrel:regulatory_crosswalk_to", "uses_submission_term", "pharmrel:uses_submission_term", "label_contains_concept", "pharmrel:label_contains_concept", "submission_codelist_maps_to", "pharmrel:submission_codelist_maps_to", "controlled_term_for_context", "pharmrel:controlled_term_for_context"]
    },
    "commercialPredicate": {
      "enum": ["commercially_related_to", "pharmrel:commercially_related_to", "product_aligned_to_indication", "pharmrel:product_aligned_to_indication", "market_segment_for_population", "pharmrel:market_segment_for_population", "payer_concept_related_to", "pharmrel:payer_concept_related_to"]
    },
    "operationalPredicate": {
      "enum": ["operational_dependency_of", "pharmrel:operational_dependency_of", "dataset_feeds_dashboard", "pharmrel:dataset_feeds_dashboard", "api_consumer_uses_term", "pharmrel:api_consumer_uses_term", "workflow_depends_on_source", "pharmrel:workflow_depends_on_source", "downstream_uses_mapping", "pharmrel:downstream_uses_mapping"]
    },
    "evidenceSupportPredicate": {
      "enum": ["entity_supported_by_evidence", "pharmrel:entity_supported_by_evidence", "assertion_supported_by_evidence", "pharmrel:assertion_supported_by_evidence", "evidence_supports_relationship", "pharmrel:evidence_supports_relationship", "evidence_contradicts_relationship", "pharmrel:evidence_contradicts_relationship", "evidence_context_for_relationship", "pharmrel:evidence_context_for_relationship"]
    },
    "inferredPredicate": {
      "enum": ["inferred_from_path", "pharmrel:inferred_from_path", "inferred_mechanistic_bridge", "pharmrel:inferred_mechanistic_bridge", "inferred_clinical_bridge", "pharmrel:inferred_clinical_bridge", "inferred_safety_context", "pharmrel:inferred_safety_context"]
    },
    "hypothesisPredicate": {
      "enum": ["hypothesis_bridge", "pharmrel:hypothesis_bridge", "is_hypothesis_about", "pharmrel:is_hypothesis_about", "may_relate_to_investigation", "pharmrel:may_relate_to_investigation", "accepted_for_investigation", "pharmrel:accepted_for_investigation", "convertedToRelationshipAssertion", "pharmrel:convertedToRelationshipAssertion"]
    },
    "blockedPredicate": {
      "enum": ["unsupported", "pharmrel:unsupported", "blocked", "pharmrel:blocked", "notMatch", "pharmrel:notMatch", "contradicted_by_evidence", "pharmrel:contradicted_by_evidence", "license_blocked", "pharmrel:license_blocked", "causal_claim_blocked", "pharmrel:causal_claim_blocked", "access_blocked", "pharmrel:access_blocked"]
    },
    "secondaryRelationshipTag": {
      "type": "string",
      "enum": ["causal_sensitive", "restricted_evidence", "patient_impacting"]
    },
    "assertionType": {
      "type": "string",
      "enum": ["imported", "human_curated", "inferred", "model_suggested", "system_generated", "deprecated"]
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["draft", "proposed", "in_review", "approved", "rejected", "released", "deprecated", "superseded"]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence_score", "confidence_band", "confidence_source", "calibration_id", "fabricated"],
      "properties": {
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_band": { "type": "string", "enum": ["high", "medium", "low", "blocked"] },
        "confidence_source": {
          "type": "string",
          "enum": ["source_asserted", "model_calibrated_score", "rule_score", "reviewer_decision", "path_confidence_engine"]
        },
        "calibration_id": { "type": ["string", "null"] },
        "fabricated": { "const": false },
        "confidence_rationale": { "type": ["string", "null"] }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_role", "source_name", "source_version", "source_record_id", "source_span_ids"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_role": {
          "type": "string",
          "enum": ["supports", "contradicts", "context", "source_only", "validation_evidence", "approval_evidence"]
        },
        "source_name": { "type": "string", "minLength": 1 },
        "source_version": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": ["string", "null"] },
        "source_span_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_type": {
          "type": "string",
          "enum": ["source_record", "document", "text_span", "structured_field", "artifact", "citation", "validation_report", "approval_record"]
        },
        "disclaimer_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_for_release": { "type": "boolean" }
      }
    },
    "releaseContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "scope", "included_in_release"],
      "properties": {
        "release_id": { "type": ["string", "null"] },
        "scope": { "type": "string", "enum": ["working", "release", "release_candidate"] },
        "included_in_release": { "type": "boolean" },
        "release_candidate_id": { "type": ["string", "null"] }
      }
    },
    "dataLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_status", "license_classification", "permitted_uses", "export_restrictions", "data_sensitivity"],
      "properties": {
        "license_status": { "type": "string", "enum": ["valid", "restricted", "blocked", "pending_review", "not_required"] },
        "license_classification": {
          "type": "string",
          "enum": [
            "open_materializable",
            "open_with_attribution",
            "licensed_federated",
            "licensed_materializable_with_restrictions",
            "internal_confidential",
            "contains_phi_or_pii",
            "blocked_pending_legal_review"
          ]
        },
        "license_policy_id": { "type": ["string", "null"] },
        "permitted_uses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "export_restrictions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "data_sensitivity": {
          "type": "string",
          "enum": ["public", "restricted_public", "licensed", "internal_confidential", "phi_pii", "unknown"]
        }
      }
    },
    "relationshipWarning": {
      "type": "string",
      "enum": [
        "contains_model_suggested_content",
        "contains_inferred_content",
        "contains_hypothesis_content",
        "contains_restricted_evidence",
        "contains_redacted_evidence",
        "contains_safety_non_causal_limitation",
        "contains_causal_claim",
        "contains_conflicting_evidence",
        "not_in_released_context",
        "requires_human_review"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["actor", "activity", "method", "source", "time", "audit_event_id"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },

@prefix pharm: <https://w3id.org/pharmaops/ontology/core#> .
@prefix pharmrel: <https://w3id.org/pharmaops/ontology/relationship#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pharm:EntityRequiredLabelShape
    a sh:NodeShape ;
    sh:targetClass pharm:GovernedObject ;
    sh:targetSubjectsOf pharm:canonicalId ;
    sh:property [
        sh:path pharm:preferredLabel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Governed objects require one non-empty preferred label." ;
    ] .

pharm:EntityTypeRequiredShape
    a sh:NodeShape ;
    sh:targetClass pharm:GovernedObject ;
    sh:targetSubjectsOf pharm:canonicalId ;
    sh:property [
        sh:path pharm:entityType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "Compound"
            "Target"
            "Gene"
            "Protein"
            "DiseaseCondition"
            "Trial"
            "ProductDrug"
            "AdverseEvent"
            "DocumentEvidenceSource"
            "VocabularyTerm"
            "MappingAssertion"
            "RelationshipAssertion"
            "RelationshipPath"
            "BridgeHypothesis"
            "PathQuery"
            "PathEvaluation"
            "WeakLinkAssessment"
            "RelationshipEvidence"
            "DomainBoundaryCrossing"
            "SafetyLimitation"
            "RelationshipWarning"
            "ReleaseArtifact"
            "Biomarker"
            "Endpoint"
            "OrganizationSponsor"
        ) ;
        sh:message "Governed objects require exactly one approved entityType value." ;
    ] .

pharm:IdentifierFormatShape
    a sh:NodeShape ;
    sh:targetClass pharm:GovernedObject ;
    sh:targetSubjectsOf pharm:entityType ;
    sh:property [
        sh:path pharm:canonicalId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Za-z][A-Za-z0-9_-]*:.+" ;
        sh:message "canonicalId must be a CURIE-like identifier with a registered prefix." ;
    ] .

pharm:ProvenanceRecordShape
    a sh:NodeShape ;
    sh:targetClass pharm:ProvenanceRecord ;
    sh:property [
        sh:path pharm:provenanceId ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^pharmprov:.+" ;
    ] ;
    sh:property [
        sh:path pharm:actor ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path pharm:activityType ;
        sh:minCount 1 ;
        sh:in ( "import" "normalize" "suggest" "validate" "submit" "approve" "reject" "revise" "stage" "release" "rollback" "export" "deprecate" "supersede" "audit" "redact" "infer" ) ;
    ] ;
    sh:property [
        sh:path pharm:activityId ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path pharm:sourceName ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path pharm:sourceVersion ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path pharm:generatedAtTime ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime ;
    ] ;
    sh:property [
        sh:path pharm:methodType ;
        sh:minCount 1 ;
        sh:in ( "rule" "model" "manual_edit" "connector_transform" "inference_rule" "reviewer_decision" "release_process" ) ;
    ] ;
    sh:property [
        sh:path pharm:confidenceType ;
        sh:minCount 1 ;
        sh:in ( "model_score" "rule_score" "reviewer_decision" "corroboration_count" "not_applicable" "source_asserted" ) ;
    ] ;
    sh:property [
        sh:path pharm:environmentName ;
        sh:minCount 1 ;
        sh:in ( "local" "dev" "test" "staging" "release_candidate" "production" ) ;
    ] ;
    sh:property [
        sh:path pharm:tenantId ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path pharm:releaseStatus ;
        sh:minCount 1 ;
        sh:in ( "not_released" "release_candidate" "released" "deprecated" "superseded" "rolled_back" ) ;
    ] ;
    sh:property [
        sh:path pharm:auditEventId ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ] .

pharm:EvidenceObjectShape
    a sh:NodeShape ;
    sh:targetClass pharm:DocumentEvidenceSource ;
    sh:property [ sh:path pharm:evidenceId ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^pharmev:.+" ] ;
    sh:property [ sh:path pharm:evidenceType ; sh:minCount 1 ; sh:in ( "source_record" "document" "text_span" "structured_field" "artifact" "citation" "validation_report" "approval_record" ) ] ;
    sh:property [ sh:path pharm:evidenceSourceName ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path pharm:evidenceSourceVersion ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path pharm:sourceRecordId ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path pharm:sourceRetrievedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path pharm:confidenceType ; sh:minCount 1 ; sh:in ( "source_asserted" "model_score" "rule_score" "reviewer_decision" "not_applicable" ) ] ;
    sh:property [ sh:path pharm:provenanceId ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^pharmprov:.+" ] ;
    sh:property [ sh:path pharm:licenseClassification ; sh:minCount 1 ; sh:in ( "open_materializable" "open_with_attribution" "licensed_federated" "licensed_materializable_with_restrictions" "internal_confidential" "contains_phi_or_pii" "blocked_pending_legal_review" ) ] ;
    sh:property [ sh:path pharm:disclaimerId ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path pharm:tenantId ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path pharm:visibility ; sh:minCount 1 ; sh:in ( "public" "tenant" "restricted" "privileged" "blocked" ) ] .

pharm:SourceProvenanceShape
    a sh:NodeShape ;
    sh:targetClass pharm:GovernedObject ;
    sh:targetSubjectsOf pharm:canonicalId ;
    sh:property [
        sh:path pharm:hasProvenance ;
        sh:minCount 1 ;
        sh:node pharm:ProvenanceRecordShape ;
        sh:message "Governed objects require provenance with actor, source, source version, and timestamp." ;
    ] .

pharm:MappingCompletenessShape
    a sh:NodeShape ;
    sh:targetClass pharm:MappingAssertion ;
    sh:property [ sh:path pharm:sourceEntity ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path pharm:targetEntity ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path pharm:mappingPredicate ; sh:minCount 1 ; sh:in ( "exactMatch" "closeMatch" "broadMatch" "narrowMatch" "relatedMatch" "replacedBy" "hasDbXref" "notMatch" "uncertainMatch" "requiresReview" ) ] ;
    sh:property [ sh:path pharm:sourceVocabulary ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path pharm:sourceVocabularyVersion ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:message "Mapping assertion requires source vocabulary version." ] ;
    sh:property [ sh:path pharm:targetVocabulary ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path pharm:targetVocabularyVersion ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:message "Mapping assertion requires target vocabulary version." ] ;
    sh:property [ sh:path pharm:confidenceScore ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
    sh:property [ sh:path pharm:hasEvidence ; sh:minCount 1 ; sh:class pharm:DocumentEvidenceSource ] ;
    sh:property [ sh:path pharm:reviewStatus ; sh:minCount 1 ; sh:in ( "draft" "proposed" "approved" "rejected" "deprecated" "released" ) ] ;
    sh:property [ sh:path pharm:releaseMembership ; sh:minCount 1 ; sh:datatype xsd:string ] ;

pharm:RelationshipCompletenessShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:property [ sh:path pharm:relationshipSubject ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path pharm:relationshipPredicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path pharm:relationshipObject ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path pharm:hasRelationshipClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "identity" "vocabulary_crosswalk" "hierarchical" "mechanistic" "clinical" "safety" "regulatory" "commercial" "operational" "evidence_support" "inferred" "hypothesis" "blocked" ) ; sh:message "Relationship assertions require one approved relationship class." ] ;
    sh:property [ sh:path pharm:assertionType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "asserted" "imported" "human_curated" "inferred" "model_suggested" "system_generated" "deprecated" ) ] ;
    sh:property [ sh:path pharm:hasAssertionType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "asserted" "imported" "human_curated" "inferred" "model_suggested" "system_generated" "deprecated" ) ; sh:message "Relationship assertions require addendum hasAssertionType metadata." ] ;
    sh:property [ sh:path pharm:relationshipDirectionality ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "directed" "undirected" "bidirectional" ) ] ;
    sh:property [ sh:path pharm:relationshipPolarity ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "positive" "negative" "neutral" "unknown" ) ] ;
    sh:property [ sh:path pharm:confidenceScore ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
    sh:property [ sh:path pharm:confidenceBand ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "high" "medium" "low" "blocked" ) ] ;
    sh:property [ sh:path pharm:hasEvidenceStrength ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "strong" "moderate" "weak" "insufficient" "blocked" ) ] ;
    sh:property [ sh:path pharm:hasEvidence ; sh:minCount 1 ; sh:class pharm:DocumentEvidenceSource ] ;
    sh:property [ sh:path pharm:reviewStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "draft" "proposed" "in_review" "approved" "rejected" "released" "deprecated" "superseded" "blocked" ) ; sh:message "Relationship assertions require governed review status." ] ;
    sh:property [ sh:path pharm:dataLicenseClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "open_materializable" "open_with_attribution" "licensed_federated" "licensed_materializable_with_restrictions" "internal_confidential" "contains_phi_or_pii" "blocked_pending_legal_review" ) ; sh:message "Relationship assertions require license metadata." ] ;
    sh:property [ sh:path pharm:lifecycleStatus ; sh:minCount 1 ; sh:in ( "draft" "proposed" "validated" "in_review" "revision_requested" "approved" "staged" "released" "deprecated" "superseded" "rejected" "rolled_back" ) ] ;
    sh:property [ sh:path pharm:releaseMembership ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path pharm:releaseId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Relationship assertions require explicit release context; use not_released before publication." ] ;
    sh:property [ sh:path pharm:createdBy ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path pharm:createdAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path pharm:updatedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path pharm:hasProvenance ; sh:minCount 1 ; sh:node pharm:ProvenanceRecordShape ; sh:message "Relationship assertions require full provenance." ] .

pharm:LifecycleTransitionShape
    a sh:NodeShape ;
    sh:targetClass pharm:GovernedObject ;
    sh:targetSubjectsOf pharm:canonicalId ;
    sh:property [
        sh:path pharm:lifecycleStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "draft" "proposed" "validated" "in_review" "revision_requested" "approved" "staged" "released" "deprecated" "superseded" "rejected" "rolled_back" ) ;
        sh:message "Lifecycle status must be one of the 12 governed states." ;
    ] .

pharm:ReleaseInclusionShape
    a sh:NodeShape ;
    sh:targetClass pharm:ReleaseArtifact ;
    sh:property [ sh:path pharm:releaseMembership ; sh:minCount 1 ; sh:pattern "^graph:tenant:.+:release:.+" ; sh:message "Release artifact must identify a tenant-scoped release graph." ] ;
    sh:property [ sh:path pharm:hasProvenance ; sh:minCount 1 ; sh:node pharm:ProvenanceRecordShape ] .

pharm:DeprecationSupersessionShape
    a sh:NodeShape ;
    sh:targetClass pharm:GovernedObject ;
    sh:targetSubjectsOf pharm:lifecycleStatus ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:lifecycleStatus ; sh:hasValue "deprecated" ] ] ]
        [
            sh:property [ sh:path pharm:lifecycleStatus ; sh:hasValue "deprecated" ] ;
            sh:property [ sh:path pharm:deprecationReason ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
        ]
    ) ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:lifecycleStatus ; sh:hasValue "superseded" ] ] ]
        [
            sh:property [ sh:path pharm:lifecycleStatus ; sh:hasValue "superseded" ] ;
            sh:property [ sh:path pharm:successorEntity ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
        ]
    ) .

pharm:AiSuggestionMetadataShape
    a sh:NodeShape ;
    sh:targetClass pharm:GovernedObject ;
    sh:targetSubjectsOf pharm:assertionType ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:assertionType ; sh:hasValue "model_suggested" ] ] ]
        [
            sh:property [ sh:path pharm:assertionType ; sh:hasValue "model_suggested" ] ;
            sh:property [ sh:path pharm:modelName ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:modelVersion ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:modelRationale ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:hasEvidence ; sh:minCount 1 ; sh:class pharm:DocumentEvidenceSource ] ;
        ]
    ) .

pharm:ModelSuggestedPublicationBlockerShape
    a sh:NodeShape ;
    sh:targetClass pharm:MappingAssertion ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:targetSubjectsOf pharm:assertionType ;
    sh:or (
        [
            sh:not [
                sh:or (
                    [ sh:property [ sh:path pharm:assertionType ; sh:hasValue "model_suggested" ] ]
                    [ sh:property [ sh:path ( pharm:hasProvenance pharm:methodType ) ; sh:hasValue "model" ] ]
                )
            ]
        ]
        [
            sh:property [
                sh:path pharm:lifecycleStatus ;
                sh:in ( "draft" "proposed" "in_review" "revision_requested" ) ;
                sh:message "model_suggested assertions and model-method provenance cannot be approved, staged, or released." ;
            ] ;
            sh:property [
                sh:path pharm:releaseMembership ;
                sh:not [ sh:pattern "^graph:tenant:.+:release:.+" ] ;
                sh:message "model_suggested assertions and model-method provenance cannot be members of release named graphs." ;
            ] ;
        ]
    ) .

pharm:MinimumEvidenceByAssertionTypeShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:property [
        sh:path pharm:hasEvidence ;
        sh:minCount 1 ;
        sh:class pharm:DocumentEvidenceSource ;
        sh:message "Relationship assertions require evidence; policy exceptions are workflow-owned and must not bypass SHACL provenance checks." ;
    ] .

pharm:RelationshipClassValidityShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:property [
        sh:path pharm:hasRelationshipClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "identity" "vocabulary_crosswalk" "hierarchical" "mechanistic" "clinical" "safety" "regulatory" "commercial" "operational" "evidence_support" "inferred" "hypothesis" "blocked" ) ;
        sh:severity sh:Violation ;
        sh:message "CRITICAL: relationship_class must be one Semantic Bridge taxonomy value." ;
    ] .

pharm:EvidenceRequirementsByRelationshipClassShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:property [
        sh:path pharm:hasEvidence ;
        sh:minCount 1 ;
        sh:class pharm:DocumentEvidenceSource ;
        sh:severity sh:Violation ;
        sh:message "CRITICAL: released or candidate relationship assertions cannot exist without evidence." ;
    ] ;
    sh:property [
        sh:path pharm:hasEvidenceStrength ;
        sh:minCount 1 ;
        sh:in ( "strong" "moderate" "weak" "insufficient" "blocked" ) ;
        sh:severity sh:Violation ;
        sh:message "Relationship assertions require evidence strength so weak links can be explained." ;
    ] .

pharm:IdentityMappingSeparationShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:not [
        sh:property [
            sh:path pharm:mappingPredicate ;
            sh:minCount 1 ;
        ]
    ] ;
    sh:property [
        sh:path pharm:relationshipPredicate ;
        sh:minCount 1 ;
        sh:message "Relationship assertions use relationshipPredicate; mappingPredicate remains limited to MappingAssertion." ;
    ] ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: MappingAssertion and RelationshipAssertion must stay distinct; identity/vocabulary mappings are not collapsed into bare relationship edges." .

pharm:RelationshipPredicateClassMatrixShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:sparql [
        sh:message "CRITICAL: relationshipPredicate must be legal for the relationship_class; mapping predicates such as exactMatch are illegal on evidence/domain classes." ;
        sh:select """
            PREFIX pharm: <https://w3id.org/pharmaops/ontology/core#>
            PREFIX pharmrel: <https://w3id.org/pharmaops/ontology/relationship#>
            SELECT $this WHERE {
              $this pharm:hasRelationshipClass ?class ;
                    pharm:relationshipPredicate ?predicate .
              FILTER (
                (?class = "identity" && ?predicate NOT IN (pharmrel:same_as, pharmrel:has_synonym, pharmrel:has_external_identifier, pharmrel:identity_replaced_by, pharmrel:exactMatch)) ||
                (?class = "vocabulary_crosswalk" && ?predicate NOT IN (pharmrel:exactMatch, pharmrel:closeMatch, pharmrel:broadMatch, pharmrel:narrowMatch, pharmrel:relatedMatch, pharmrel:replacedBy, pharmrel:hasDbXref, pharmrel:notMatch, pharmrel:uncertainMatch, pharmrel:requiresReview, pharmrel:term_maps_to_standard, pharmrel:regulatory_crosswalk_to)) ||
                (?class = "hierarchical" && ?predicate NOT IN (pharmrel:broader_than, pharmrel:narrower_than, pharmrel:parent_of, pharmrel:child_of, pharmrel:part_of, pharmrel:has_part, pharmrel:subclass_of)) ||
                (?class = "mechanistic" && ?predicate NOT IN (pharmrel:compound_has_target, pharmrel:target_associated_with_disease, pharmrel:mechanistically_related_to, pharmrel:inhibits, pharmrel:activates, pharmrel:binds_target, pharmrel:modulates_pathway)) ||
                (?class = "clinical" && ?predicate NOT IN (pharmrel:trial_studies_condition, pharmrel:trial_uses_intervention, pharmrel:trial_has_endpoint, pharmrel:clinically_related_to, pharmrel:associated_with_outcome, pharmrel:biomarker_stratifies_response)) ||
                (?class = "safety" && ?predicate NOT IN (pharmrel:product_has_adverse_event, pharmrel:safety_context_related_to, pharmrel:has_reported_event_context, pharmrel:label_mentions_safety_event, pharmrel:safety_signal_for_investigation)) ||
                (?class = "regulatory" && ?predicate NOT IN (pharmrel:regulatory_crosswalk_to, pharmrel:uses_submission_term, pharmrel:label_contains_concept, pharmrel:submission_codelist_maps_to, pharmrel:controlled_term_for_context)) ||
                (?class = "commercial" && ?predicate NOT IN (pharmrel:commercially_related_to, pharmrel:product_aligned_to_indication, pharmrel:market_segment_for_population, pharmrel:payer_concept_related_to)) ||
                (?class = "operational" && ?predicate NOT IN (pharmrel:operational_dependency_of, pharmrel:dataset_feeds_dashboard, pharmrel:api_consumer_uses_term, pharmrel:workflow_depends_on_source, pharmrel:downstream_uses_mapping)) ||
                (?class = "evidence_support" && ?predicate NOT IN (pharmrel:entity_supported_by_evidence, pharmrel:assertion_supported_by_evidence, pharmrel:evidence_supports_relationship, pharmrel:evidence_contradicts_relationship, pharmrel:evidence_context_for_relationship)) ||
                (?class = "inferred" && ?predicate NOT IN (pharmrel:inferred_from_path, pharmrel:inferred_mechanistic_bridge, pharmrel:inferred_clinical_bridge, pharmrel:inferred_safety_context)) ||
                (?class = "hypothesis" && ?predicate NOT IN (pharmrel:hypothesis_bridge, pharmrel:is_hypothesis_about, pharmrel:may_relate_to_investigation, pharmrel:accepted_for_investigation, pharmrel:convertedToRelationshipAssertion)) ||
                (?class = "blocked" && ?predicate NOT IN (pharmrel:unsupported, pharmrel:blocked, pharmrel:notMatch, pharmrel:contradicted_by_evidence, pharmrel:license_blocked, pharmrel:causal_claim_blocked, pharmrel:access_blocked))
              )
            }
        """ ;
    ] .

pharm:SafetyLimitationRequirementsShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:hasRelationshipClass ; sh:hasValue "safety" ] ] ]
        [
            sh:property [ sh:path pharm:hasRelationshipClass ; sh:hasValue "safety" ] ;
            sh:property [ sh:path pharm:safetyLimitationId ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:knownLimitation ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:hasCausalClaimStatus ; sh:minCount 1 ; sh:in ( "not_causal" "causal_review_required" "causal_review_approved" "causal_prohibited" "blocked_overclaim" ) ] ;
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: safety relationships require limitation metadata and causal-status labeling." .

pharm:CausalClaimRestrictionsShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:property [
        sh:path pharm:hasCausalClaimStatus ;
        sh:maxCount 1 ;
        sh:in ( "not_causal" "causal_review_required" "causal_review_approved" "causal_prohibited" "blocked_overclaim" ) ;
        sh:message "causal_claim_status must use Andy's canonical enum." ;
    ] ;
    sh:or (
        [
            sh:property [ sh:path pharm:hasCausalClaimStatus ; sh:in ( "not_causal" "causal_review_approved" ) ] ;
        ]
        [
            sh:not [ sh:property [ sh:path pharm:lifecycleStatus ; sh:in ( "approved" "staged" "released" ) ] ] ;
        ]
        [
            sh:property [ sh:path pharm:hasCausalClaimStatus ; sh:hasValue "causal_review_approved" ] ;
            sh:property [ sh:path pharm:reviewStatus ; sh:in ( "approved" "released" ) ] ;
            sh:property [ sh:path pharm:reviewedBy ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:reviewedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ] ;
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: causal_claim_status must use Andy's canonical enum; non-cleared states block approved, staged, and released assertions." .

pharm:ReviewStateRestrictionsShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:lifecycleStatus ; sh:in ( "approved" "staged" "released" ) ] ] ]
        [
            sh:property [ sh:path pharm:reviewStatus ; sh:in ( "approved" "released" ) ] ;
            sh:property [ sh:path pharm:reviewedBy ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:reviewedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ] ;
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: approved, staged, or released relationship assertions require reviewer identity and timestamp." .

pharm:ReleasedRelationshipRequirementsShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:lifecycleStatus ; sh:hasValue "released" ] ] ]
        [
            sh:property [ sh:path pharm:releaseId ; sh:minCount 1 ; sh:not [ sh:hasValue "not_released" ] ] ;
            sh:property [ sh:path pharm:validationReportId ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:hasEvidence ; sh:minCount 1 ; sh:class pharm:DocumentEvidenceSource ] ;
            sh:property [ sh:path pharm:reviewStatus ; sh:hasValue "released" ] ;
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: released relationships require evidence, release ID, released review status, and validation report." .

pharm:ReleasedRelationshipLicenseReviewerShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:lifecycleStatus ; sh:hasValue "released" ] ] ]
        [
            sh:property [ sh:path pharm:reviewedBy ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:not [ sh:hasValue "null" ] ] ;
            sh:property [ sh:path pharm:reviewedAt ; sh:minCount 1 ; sh:datatype xsd:dateTime ] ;
            sh:property [ sh:path pharm:dataLicenseClass ; sh:not [ sh:hasValue "blocked_pending_legal_review" ] ] ;
            sh:property [ sh:path pharm:exportAuthorizationStatus ; sh:not [ sh:hasValue "blocked" ] ] ;
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: released relationships require non-null reviewer metadata and non-blocked license/export authorization." .

pharm:PathConfidenceConstraintsShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipPath ;
    sh:property [ sh:path pharm:hasPathConfidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
    sh:property [ sh:path pharm:pathConfidenceBand ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "high" "medium" "low" "blocked" ) ] ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:pathContainsUnreviewedModelSuggestedEdge ; sh:hasValue true ] ] ]
        [ sh:not [ sh:property [ sh:path pharm:pathConfidenceBand ; sh:hasValue "high" ] ] ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: a path with an unreviewed model-suggested edge cannot be marked high confidence." .

pharm:ReleasedPathEdgeDerivedRequirementsShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipPath ;
    sh:sparql [
        sh:message "CRITICAL: released or high-confidence paths must be bounded by edge-derived assertion type, review state, and weakest confidence." ;
        sh:select """
            PREFIX pharm: <https://w3id.org/pharmaops/ontology/core#>
            SELECT $this WHERE {
              $this pharm:relationshipPathEdge ?edge .
              OPTIONAL { $this pharm:pathStatus ?pathStatus . }
              OPTIONAL { $this pharm:pathConfidenceBand ?pathBand . }
              OPTIONAL { ?edge pharm:assertionType ?edgeAssertionType . }
              OPTIONAL { ?edge pharm:hasAssertionType ?edgeAssertionType2 . }
              OPTIONAL { ?edge pharm:reviewStatus ?edgeReviewStatus . }
              OPTIONAL { ?edge pharm:confidenceBand ?edgeConfidenceBand . }
              FILTER (
                (?pathStatus = "released" && (?edgeAssertionType = "model_suggested" || ?edgeAssertionType2 = "model_suggested")) ||
                (?pathStatus = "released" && ?edgeReviewStatus NOT IN ("approved", "released")) ||
                (?pathStatus = "released" && ?edgeConfidenceBand = "blocked") ||
                (?pathBand = "high" && (?edgeAssertionType = "model_suggested" || ?edgeAssertionType2 = "model_suggested")) ||
                (?pathBand = "high" && ?edgeReviewStatus NOT IN ("approved", "released")) ||
                (?pathBand = "high" && ?edgeConfidenceBand != "high") ||
                (?pathBand = "medium" && ?edgeConfidenceBand IN ("low", "blocked"))
              )
            }
        """ ;
    ] .

pharm:WeakestLinkRequirementsShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipPath ;
    sh:property [
        sh:path pharm:hasWeakestLink ;
        sh:minCount 1 ;
        sh:class pharm:WeakLinkAssessment ;
        sh:severity sh:Violation ;
        sh:message "Relationship paths require weakest-link assessment." ;
    ] .

pharm:RestrictedEvidenceAccessMetadataShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:targetClass pharm:RelationshipPath ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:usesRestrictedEvidence ; sh:hasValue true ] ] ]
        [
            sh:property [ sh:path pharm:usesRestrictedEvidence ; sh:hasValue true ] ;
            sh:property [ sh:path pharm:hasRedactionPolicy ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:exportAuthorizationStatus ; sh:in ( "authorized" "redacted" "blocked" ) ] ;
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: restricted evidence must carry export authorization and redaction metadata." .

pharm:HypothesisLabelingShape
    a sh:NodeShape ;
    sh:targetClass pharm:BridgeHypothesis ;
    sh:property [ sh:path pharm:isHypothesisAbout ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path pharm:hasRelationshipWarning ; sh:minCount 1 ; sh:class pharm:RelationshipWarning ] ;
    sh:property [ sh:path pharm:reviewStatus ; sh:minCount 1 ; sh:in ( "draft" "proposed" "in_review" "rejected" "blocked" ) ] ;
    sh:property [ sh:path pharm:lifecycleStatus ; sh:in ( "draft" "proposed" "in_review" "revision_requested" "rejected" "rolled_back" ) ] ;
    sh:severity sh:Violation ;
    sh:message "Bridge hypotheses must stay visibly labeled and unreleased until converted to a reviewed relationship assertion." .

pharm:ReleasedPathRequirementsShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipPath ;
    sh:property [ sh:path pharm:relationshipPathStart ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path pharm:relationshipPathEnd ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path pharm:relationshipPathEdge ; sh:minCount 1 ; sh:class pharm:RelationshipAssertion ] ;
    sh:property [ sh:path pharm:pathStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "draft" "proposed" "in_review" "approved" "released" "blocked" ) ] ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pharm:pathStatus ; sh:hasValue "released" ] ] ]
        [
            sh:property [ sh:path pharm:releaseId ; sh:minCount 1 ; sh:not [ sh:hasValue "not_released" ] ] ;
            sh:property [ sh:path pharm:validationReportId ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:pathContainsBlockedEdge ; sh:hasValue false ] ;
            sh:property [ sh:path pharm:exportAuthorizationStatus ; sh:in ( "authorized" "redacted" ) ] ;
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: released paths require a release ID, validation report, no blocked edge, and authorized or redacted export state." .

pharm:BlockedRelationshipRationaleShape
    a sh:NodeShape ;
    sh:targetClass pharm:RelationshipAssertion ;
    sh:targetClass pharm:RelationshipPath ;
    sh:or (
        [
            sh:not [
                sh:or (
                    [ sh:property [ sh:path pharm:hasRelationshipClass ; sh:hasValue "blocked" ] ]
                    [ sh:property [ sh:path pharm:confidenceBand ; sh:hasValue "blocked" ] ]
                    [ sh:property [ sh:path pharm:pathConfidenceBand ; sh:hasValue "blocked" ] ]
                    [ sh:property [ sh:path pharm:pathContainsBlockedEdge ; sh:hasValue true ] ]
                )
            ]
        ]
        [
            sh:property [ sh:path pharm:blockedRationale ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
            sh:property [ sh:path pharm:hasRelationshipWarning ; sh:minCount 1 ; sh:class pharm:RelationshipWarning ] ;
        ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "CRITICAL: blocked relationships or paths require a rationale and warning." .

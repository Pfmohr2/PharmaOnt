@prefix pharm: <https://w3id.org/pharmaops/ontology/core#> .
@prefix pharmrel: <https://w3id.org/pharmaops/ontology/relationship#> .
@prefix pharment: <https://example.pharmaops.local/tenant/acme/entity/> .
@prefix pharmrelobj: <https://example.pharmaops.local/tenant/acme/relationship/> .
@prefix pharmev: <https://example.pharmaops.local/tenant/acme/evidence/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pharmrelobj:rt011-relationship-subject-literal
    a pharm:RelationshipAssertion ;
    pharm:canonicalId "pharmrelobj:rt011-relationship-subject-literal" ;
    pharm:entityType "RelationshipAssertion" ;
    pharm:preferredLabel "Invalid literal relationship subject" ;
    pharm:lifecycleStatus "approved" ;
    pharm:assertionType "human_curated" ;
    pharm:hasAssertionType "human_curated" ;
    pharm:hasRelationshipClass "mechanistic" ;
    pharm:relationshipDirectionality "directed" ;
    pharm:relationshipPolarity "positive" ;
    pharm:confidenceScore 0.91 ;
    pharm:confidenceBand "high" ;
    pharm:hasEvidenceStrength "strong" ;
    pharm:hasEvidence pharmev:rt011-subject-literal ;
    pharm:reviewStatus "approved" ;
    pharm:reviewedBy "curator:fixture" ;
    pharm:reviewedAt "2026-06-27T16:55:00Z"^^xsd:dateTime ;
    pharm:dataLicenseClass "open_materializable" ;
    pharm:releaseId "not_released" ;
    pharm:createdBy "curator:fixture" ;
    pharm:createdAt "2026-06-27T16:55:00Z"^^xsd:dateTime ;
    pharm:updatedAt "2026-06-27T16:55:00Z"^^xsd:dateTime ;
    pharm:hasCausalClaimStatus "not_causal" ;
    pharm:usesRestrictedEvidence false ;
    pharm:exportAuthorizationStatus "authorized" ;
    pharm:releaseMembership "graph:tenant:acme:data:canonical:working" ;
    pharm:relationshipSubject "pharment:rt011-subject-literal-source" ;
    pharm:relationshipPredicate pharmrel:compound_has_target ;
    pharm:relationshipObject pharment:rt011-subject-literal-target ;
    pharm:hasProvenance [
        a pharm:ProvenanceRecord ;
        pharm:provenanceId "pharmprov:rt011-subject-literal" ;
        pharm:activityType "approve" ;
        pharm:activityId "activity:rt011-subject-literal" ;
        pharm:methodType "reviewer_decision" ;
        pharm:confidenceType "reviewer_decision" ;
        pharm:environmentName "test" ;
        pharm:tenantId "acme" ;
        pharm:releaseStatus "not_released" ;
        pharm:auditEventId "audit:rt011-subject-literal" ;
        pharm:actor "curator:fixture" ;
        pharm:sourceName "Creed RT-011 fixture" ;
        pharm:sourceVersion "2026-06-27" ;
        pharm:generatedAtTime "2026-06-27T16:55:00Z"^^xsd:dateTime
    ] .


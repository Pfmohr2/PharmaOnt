pharmrelobj:rel-missing-provenance
    a pharm:RelationshipAssertion ;
    pharm:canonicalId "pharmrelobj:rel-missing-provenance" ;
    pharm:entityType "RelationshipAssertion" ;
    pharm:preferredLabel "Invalid target disease association missing provenance" ;
    pharm:lifecycleStatus "approved" ;
    pharm:assertionType "human_curated" ;
    pharm:confidenceScore 0.85 ;
    pharm:releaseMembership "graph:tenant:acme:data:canonical:working" ;

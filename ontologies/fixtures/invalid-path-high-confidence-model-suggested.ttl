pharmpath:path-high-confidence-model-edge
    a pharm:RelationshipPath ;
    pharm:canonicalId "pharmpath:path-high-confidence-model-edge" ;
    pharm:entityType "RelationshipPath" ;
    pharm:preferredLabel "Invalid high confidence model-suggested path" ;
    pharm:lifecycleStatus "approved" ;
    pharm:releaseMembership "graph:tenant:acme:data:canonical:working" ;
    pharm:relationshipPathStart pharment:path-start ;
    pharm:relationshipPathEnd pharment:path-end ;
    pharm:relationshipPathEdge pharmrelobj:unreviewed-model-edge ;
    pharm:hasPathConfidence 0.94 ;
    pharm:pathConfidenceBand "high" ;
    pharm:hasWeakestLink pharmpath:weak-link-invalid-000001 ;
    pharm:pathStatus "approved" ;
    pharm:releaseId "not_released" ;
    pharm:usesRestrictedEvidence false ;
    pharm:pathContainsBlockedEdge false ;
    pharm:pathContainsUnreviewedModelSuggestedEdge true ;
    pharm:exportAuthorizationStatus "authorized" ;
    pharm:hasRelationshipWarning pharmwarn:path-warning-000001 ;
    pharm:hasProvenance [
        a pharm:ProvenanceRecord ;
        pharm:provenanceId "pharmprov:invalid-path-high-confidence" ;
        pharm:activityType "validate" ;
        pharm:activityId "activity:invalid-path-high-confidence" ;
        pharm:methodType "rule" ;
        pharm:confidenceType "rule_score" ;
        pharm:environmentName "test" ;
        pharm:tenantId "acme" ;
        pharm:releaseStatus "not_released" ;
        pharm:auditEventId "audit:invalid-path-high-confidence" ;
        pharm:actor "validator:semantic-bridge" ;
        pharm:sourceName "Semantic Bridge path rules" ;
        pharm:sourceVersion "2026-06-27" ;
        pharm:generatedAtTime "2026-06-27T11:35:00Z"^^xsd:dateTime
    ] .

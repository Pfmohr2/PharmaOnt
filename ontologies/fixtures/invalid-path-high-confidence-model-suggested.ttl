@prefix pharmwarn: <https://example.pharmaops.local/tenant/acme/warning/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pharmwarn:path-warning-000001
    a pharm:RelationshipWarning ;
    pharm:canonicalId "pharmwarn:path-warning-000001" ;
    pharm:entityType "RelationshipWarning" ;
    pharm:preferredLabel "Path contains unreviewed model suggestion" ;
    pharm:lifecycleStatus "approved" ;
    pharm:releaseMembership "graph:tenant:acme:data:canonical:working" ;
    pharm:hasProvenance [
        a pharm:ProvenanceRecord ;
        pharm:provenanceId "pharmprov:invalid-path-warning" ;
        pharm:activityType "validate" ;
        pharm:activityId "activity:invalid-path-warning" ;
        pharm:methodType "rule" ;
        pharm:confidenceType "not_applicable" ;
        pharm:environmentName "test" ;
        pharm:tenantId "acme" ;
        pharm:releaseStatus "not_released" ;
        pharm:auditEventId "audit:invalid-path-warning" ;
        pharm:actor "validator:semantic-bridge" ;
        pharm:sourceName "Semantic Bridge rules" ;
        pharm:sourceVersion "2026-06-27" ;
        pharm:generatedAtTime "2026-06-27T11:35:00Z"^^xsd:dateTime
    ] .

pharmpath:weak-link-invalid-000001
    a pharm:WeakLinkAssessment ;
    pharm:canonicalId "pharmpath:weak-link-invalid-000001" ;
    pharm:entityType "WeakLinkAssessment" ;
    pharm:preferredLabel "Invalid path weakest link" ;
    pharm:lifecycleStatus "approved" ;
    pharm:releaseMembership "graph:tenant:acme:data:canonical:working" ;
